# Copy this file to `.env.local` and fill in only environment-specific values.
# The matching public contract is `dotenv.lock.json`.

# MongoDB / canonical collections
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/terminology?retryWrites=true&w=majority
MONGODB_AUTH_SOURCE=
MONGODB_DB=terminology
MONGODB_COLLECTION=snomed-irbd
MONGODB_TERM_SEARCH_COLLECTION=snomed-term-search
MONGODB_USAGE_EVENT_COLLECTION=snomed-usage-events
MONGODB_MODEL_STATE_COLLECTION=snomed-model-state

# Runtime release and query limits
SNOMED_RELEASE_ID=20260601
ECL_MAX_RESULTS=200000
SMARTSEARCH_SCOPE_MAX_IDS=20000
HIERARCHY_CACHE_TTL_SECONDS=86400
HIERARCHY_CACHE_MAX_ENTRIES=5000
SEMANTICS_SCOPE_CACHE_TTL_SECONDS=86400
SEMANTICS_SCOPE_CACHE_MAX_ENTRIES=5000

# MongoDB Search / Vector Search indexes
MONGODB_SEARCH_INDEX=snomed_text_idx
MONGODB_VECTOR_INDEX=snomed_voyage_idx
MONGODB_VECTOR_MODE=autoEmbed
MONGODB_VECTOR_PATH=embedText
MONGODB_VECTOR_AUTO_EMBED_MODEL=voyage-4
MONGODB_VECTOR_AUTO_EMBED_MODALITY=text
MONGODB_VECTOR_FILTER_PATHS=releaseId,languageCode,conceptId,semanticTag,semanticTagKey,termType,typeId,definitionStatusId,conceptActive,preferred,topRoots,areaTags,parentIds,ancestorIds,releaseDate
MONGODB_MANUAL_VECTOR_PATH=embedding_voyage_4_lite_256
MONGODB_VECTOR_DIMENSIONS=256
MONGODB_VECTOR_SIMILARITY=cosine
BUILD_MONGODB_SEARCH_INDEXES=true
BUILD_MONGODB_VECTOR_INDEX=true

# Hybrid navigation search and rerank
HYBRID_FUSION_MODE=rankFusion
HYBRID_NATIVE_FUSION_MAX_TIME_MS=8000
HYBRID_CANDIDATE_POOL=40
HYBRID_RRF_K=60
HYBRID_RERANK_POOL=40
ENABLE_HYBRID_GROUNDING=false
HYBRID_GROUNDING_POOL=20
VOYAGE_API_KEY=
VOYAGE_API_BASE_URL=
VOYAGE_RERANK_MODEL=rerank-2.5
VOYAGE_TIMEOUT_MS=8000

# Optional LLM grounding gateway
ENABLE_LLM_GROUNDING=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_AUTH_HEADER=api-key
LLM_API_STYLE=chat
LLM_GROUNDING_MODEL=gpt-5.5
LLM_GROUNDING_MODELS=gpt-5.5
LLM_GROUNDING_MAX_TOKENS=4096
NEXT_PUBLIC_LLM_GROUNDING_MODELS=gpt-5.5

# Term sidecar rebuild scope
TERM_PROJECTION_SCOPE=demo
TERM_PROJECTION_RESET=false
TERM_PROJECTION_CLEAR_TERMS=false
TERM_PROJECTION_REPLACE_RELEASE=false
TERM_PROJECTION_INCLUDE_ALL_RELEASES=false
TERM_PROJECTION_EMBED=false
PROJECTION_BUILD_ENABLED=true
PROJECTION_RESET_BEFORE_BUILD=false
PROJECTION_LANGUAGE_CODES=en,es
PROJECTION_INCLUDE_ALL_RELEASES=false
PROJECTION_TOP_ROOT_IDS=123037004,404684003,71388002,373873005,272379006,243796009,260787004,78621006,362981000
PROJECTION_CONCEPT_IDS=
PROJECTION_AREA_CONCEPT_ID=
PROJECTION_AREA_CONCEPT_IDS=
PROJECTION_AREA_RELATION=descendants
PROJECTION_INCLUDE_ROOT=true
PROJECTION_MAX_CONCEPT_IDS=8000
PROJECTION_MAX_TOTAL_CONCEPT_IDS=25000
PROJECTION_CLEAR_TERM_DOCS=false
PROJECTION_REPLACE_RELEASE_DOCS=false
PROJECTION_MAX_SYNONYMS=10
PROJECTION_WRITE_BATCH_SIZE=1000

# Manual embedding fallback. Keep disabled when MONGODB_VECTOR_MODE=autoEmbed.
EMBED_ENABLED=false
EMBED_DRY_RUN=true
EMBED_AREA_CONCEPT_ID=
EMBED_AREA_RELATION=descendants
EMBED_ELIGIBLE_ANCESTOR_IDS=404684003,71388002,363787002,123037004,373873005
EMBED_INCLUDE_ROOT=true
EMBED_MAX_CONCEPT_IDS=3000
EMBED_LANGUAGE_CODES=en,es
VOYAGE_MODEL=voyage-4-lite
VOYAGE_OUTPUT_DIMENSION=256
VECTOR_BATCH_SIZE=8
MAX_VECTOR_DOCS=300

# Maintenance scripts
RELEASE_ID_TARGET=20260601
RELEASE_DATE=
RELEASE_LABEL=
RELEASE_ID_OVERWRITE=false
NORMALIZE_APPLY=false

# Local benchmark helpers
GOLD_BASE_URL=http://localhost:3015
GOLD_SEARCH_TIMEOUT_MS=15000
